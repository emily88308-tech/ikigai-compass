# Client-side (exposed in the browser bundle — must use the VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side ONLY — used by the /api/coach serverless function.
# NO VITE_ prefix, or it would leak into the public bundle.
ANTHROPIC_API_KEY=sk-ant-...
